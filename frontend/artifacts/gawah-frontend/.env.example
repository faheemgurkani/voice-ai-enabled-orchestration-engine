# Leave empty to use Vite proxy → http://localhost:8000
# Or set absolute URL for direct CORS calls:
VITE_API_URL=

# Supabase Auth. Publishable key only — anything VITE_-prefixed ships to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

PORT=5173
BASE_PATH=/
VITE_API_PROXY_TARGET=http://localhost:8000
