# Leave empty to use Vite proxy → http://localhost:8000
# Or set absolute URL for direct CORS calls:
VITE_API_URL=

# Supabase Auth. Publishable key only — anything VITE_-prefixed ships to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile sitekey (public, safe to ship). Used on /login and the
# "Call me" form on /demo. Leave empty and the widget just doesn't render —
# both flows work unchanged, just without a CAPTCHA gate. Pair with the
# backend's TURNSTILE_SECRET_KEY for it to actually be enforced.
VITE_TURNSTILE_SITE_KEY=

PORT=5173
BASE_PATH=/
VITE_API_PROXY_TARGET=http://localhost:8000
