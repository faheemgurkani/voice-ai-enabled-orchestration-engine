{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npx --yes pnpm@10.22.0 install --no-frozen-lockfile",
  "buildCommand": "cd frontend && npx --yes pnpm@10.22.0 --filter @workspace/gawah-frontend build",
  "outputDirectory": "frontend/artifacts/gawah-frontend/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
