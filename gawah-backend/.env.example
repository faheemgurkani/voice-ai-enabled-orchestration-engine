APP_NAME=Voice AI Enabled Orchestration Engine (Gawah)
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLIFTAI_API_KEY=
UPLIFT_ASSISTANT_ID=
UPLIFT_BASE_URL=https://ap-southeast-1.api.upliftai.org/v1
UPLIFT_TTS_VOICE_ID=defense-advocate
UPLIFT_TTS_OUTPUT_FORMAT=MP3_22050_128

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini (optional LLM — alongside OpenRouter/Groq)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud STT/TTS (optional — alongside Uplift STT/TTS)
# Path to service account JSON; enables Speech + Text-to-Speech clients
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_STT_LANGUAGE_CODE=ur-PK
GOOGLE_TTS_LANGUAGE_CODE=ur-IN
GOOGLE_TTS_VOICE_NAME=
GOOGLE_TTS_SPEAKING_RATE=1.0

SUPABASE_URL=
# Publishable key (sb_publishable_...) — paired with the caller's JWT for RLS-enforced reads.
SUPABASE_KEY=
# Secret key (sb_secret_...) — bypasses RLS. Voice/webhook writes only.
SUPABASE_SERVICE_KEY=
# Optional: inbound dial-in. Voice webhook → POST /api/sessions/twilio-webhook
# Outbound "Call me" uses Uplift Singapore /calls — Twilio not required for that path.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NGO_WEBHOOK_URL=
CASE_ID_SECRET=change-me-in-production
