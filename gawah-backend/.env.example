APP_NAME=Voice AI Enabled Orchestration Engine (Gawah)
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Uplift AI — realtime voice, STT, TTS (Singapore region for PK latency) ───
UPLIFTAI_API_KEY=
UPLIFT_ASSISTANT_ID=
UPLIFT_BASE_URL=https://ap-southeast-1.api.upliftai.org/v1
UPLIFT_TTS_VOICE_ID=defense-advocate
UPLIFT_TTS_OUTPUT_FORMAT=MP3_22050_128

# ─── LLM: OpenRouter primary, Groq/OpenAI/Gemini optional fallbacks ───────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Google Cloud STT/TTS (optional — alongside Uplift, does not replace it) ──
# Path to service account JSON; enables Speech + Text-to-Speech clients
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_STT_LANGUAGE_CODE=ur-PK
GOOGLE_TTS_LANGUAGE_CODE=ur-IN
GOOGLE_TTS_VOICE_NAME=
GOOGLE_TTS_SPEAKING_RATE=1.0

# ─── Supabase — Postgres + Auth ───────────────────────────────────────────────
# Setting SUPABASE_URL flips the data layer off the local JSON store onto Postgres.
SUPABASE_URL=
# Publishable key (sb_publishable_...): paired with the caller's JWT for
# user-scoped, RLS-enforced reads.
SUPABASE_KEY=
# Secret key (sb_secret_...) bypasses RLS. Voice/webhook writes only —
# never expose to the browser or put in a VITE_-prefixed variable.
SUPABASE_SERVICE_KEY=

# Dev-only escape hatch: skips JWT verification with a fixed dev user, so the
# gated dashboard/KPI/review/PDF routes work locally without Supabase set up.
# Hard-disabled whenever APP_ENV=production, regardless of this flag's value.
DEV_AUTH_BYPASS=false
DEV_USER_ID=00000000-0000-0000-0000-000000000000
DEV_USER_EMAIL=dev@gawah.local

# ─── Twilio (optional PSTN bridge) ────────────────────────────────────────────
# Inbound dial-in only. Voice webhook → POST /api/sessions/twilio-webhook
# Outbound "Call me" uses Uplift Singapore /calls — Twilio not required for that.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Misc ─────────────────────────────────────────────────────────────────────
NGO_WEBHOOK_URL=
CASE_ID_SECRET=change-me-in-production

# Local JSON fallback paths. Leave empty to use the defaults in config.py
# (repo data/ locally, /tmp on Vercel). Ignored once SUPABASE_URL is set.
LOCAL_DB_PATH=
LOCAL_AUDIO_DIR=
